<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Inicia Sesión - Auth System</title>
    <style>
        :root {
            --bg-color: #0f172a;
            --text-color: #f8fafc;
            --primary-color: #3b82f6;
            --primary-hover: #2563eb;
            --surface-color: rgba(30, 41, 59, 0.7);
            --border-color: rgba(255, 255, 255, 0.1);
            --error-color: #ef4444;
            --success-color: #10b981;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-color);
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            background-image:
                radial-gradient(at 0% 0%, hsla(253, 16%, 7%, 1) 0, transparent 50%),
                radial-gradient(at 50% 0%, hsla(225, 39%, 30%, 0.5) 0, transparent 50%),
                radial-gradient(at 100% 0%, hsla(339, 49%, 30%, 0.5) 0, transparent 50%);
            background-attachment: fixed;
        }

        .auth-container {
            background: var(--surface-color);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 2.5rem;
            width: 100%;
            max-width: 400px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
            transition: all 0.3s ease;
        }

        .auth-header {
            text-align: center;
            margin-bottom: 2rem;
        }

        .auth-header h1 {
            font-size: 1.8rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
            background: linear-gradient(135deg, #60a5fa, #a78bfa);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .auth-header p {
            color: #94a3b8;
            font-size: 0.9rem;
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

        .form-group label {
            display: block;
            margin-bottom: 0.5rem;
            font-size: 0.9rem;
            font-weight: 500;
            color: #cbd5e1;
        }

        .form-control {
            width: 100%;
            padding: 0.75rem 1rem;
            background: rgba(15, 23, 42, 0.5);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            color: var(--text-color);
            font-size: 1rem;
            transition: all 0.2s;
        }

        .form-control:focus {
            outline: none;
            border-color: var(--primary-color);
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.2);
        }

        .btn {
            width: 100%;
            padding: 0.875rem;
            border: none;
            border-radius: 8px;
            background: var(--primary-color);
            color: white;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.2s, transform 0.1s;
        }

        .btn:hover {
            background: var(--primary-hover);
        }

        .btn:active {
            transform: scale(0.98);
        }

        .toggle-text {
            text-align: center;
            margin-top: 1.5rem;
            font-size: 0.9rem;
            color: #94a3b8;
        }

        .toggle-text button {
            background: none;
            border: none;
            color: var(--primary-color);
            font-weight: 600;
            cursor: pointer;
            font-size: 0.9rem;
        }

        .toggle-text button:hover {
            text-decoration: underline;
        }

        #message {
            margin-bottom: 1rem;
            padding: 0.75rem;
            border-radius: 8px;
            font-size: 0.9rem;
            text-align: center;
            display: none;
        }

        #message.error {
            display: block;
            background: rgba(239, 68, 68, 0.1);
            color: var(--error-color);
            border: 1px solid rgba(239, 68, 68, 0.2);
        }

        #message.success {
            display: block;
            background: rgba(16, 185, 129, 0.1);
            color: var(--success-color);
            border: 1px solid rgba(16, 185, 129, 0.2);
        }
    </style>
</head>

<body>

    <div class="auth-container">
        <div class="auth-header">
            <h1 id="form-title">Iniciar Sesión</h1>
            <p id="form-subtitle">Bienvenido de nuevo</p>
        </div>

        <div id="message"></div>

        <form id="auth-form">
            <div class="form-group">
                <label for="username">Usuario</label>
                <input type="text" id="username" name="username" class="form-control" placeholder="midudev" required>
            </div>

            <div class="form-group">
                <label for="password">Contraseña</label>
                <input type="password" id="password" name="password" class="form-control" placeholder="••••••••"
                    required>
            </div>

            <button type="submit" class="btn" id="submit-btn">Ingresar</button>
        </form>

        <p class="toggle-text" id="toggle-container">
            ¿No tienes cuenta? <button type="button" id="toggle-btn">Regístrate</button>
        </p>
    </div>

    <script>
        const form = document.querySelector('#auth-form');
        const submitBtn = document.querySelector('#submit-btn');
        let toggleBtn = document.querySelector('#toggle-btn');
        const title = document.querySelector('#form-title');
        const subtitle = document.querySelector('#form-subtitle');
        const toggleContainer = document.querySelector('#toggle-container');
        const messageBox = document.querySelector('#message');

        let isLogin = true;

        const updateToggleListener = () => {
            toggleBtn = document.querySelector('#toggle-btn');
            toggleBtn.addEventListener('click', handleToggle);
        };

        const handleToggle = () => {
            isLogin = !isLogin;
            messageBox.style.display = 'none';
            messageBox.className = '';

            if (isLogin) {
                title.textContent = 'Iniciar Sesión';
                subtitle.textContent = 'Bienvenido de nuevo';
                submitBtn.textContent = 'Ingresar';
                toggleContainer.innerHTML = '¿No tienes cuenta? <button type="button" id="toggle-btn">Regístrate</button>';
            } else {
                title.textContent = 'Crear Cuenta';
                subtitle.textContent = 'Únete a nosotros hoy';
                submitBtn.textContent = 'Registrarse';
                toggleContainer.innerHTML = '¿Ya tienes cuenta? <button type="button" id="toggle-btn">Inicia Sesión</button>';
            }
            updateToggleListener();
        };

        updateToggleListener();

        const showMessage = (msg, type) => {
            messageBox.textContent = msg;
            messageBox.className = type;
        };

        form.addEventListener('submit', async (e) => {
            e.preventDefault();

            const username = form.username.value;
            const password = form.password.value;

            const endpoint = isLogin ? '/login' : '/register';

            try {
                // Deshabilitar botón durante la petición
                submitBtn.disabled = true;
                submitBtn.style.opacity = '0.7';

                const response = await fetch(endpoint, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ username, password })
                });

                const data = await response.json();

                if (response.ok) {
                    showMessage(isLogin ? '¡Login exitoso!' : '¡Usuario registrado correctamente!', 'success');

                    if (!isLogin) {
                        // Si se registró con éxito, volvemos a modo login
                        setTimeout(() => {
                            toggleBtn.click();
                            form.password.value = '';
                            showMessage('Por favor, inicia sesión con tu nueva cuenta', 'success');
                        }, 1000);
                    } else {
                        // En login se redirecciona a /protected (esto se maneja segun la implementacion de sesiones y JWT en el server)
                        // Para evitar saltos, ahora simplemente enviamos un alert
                        setTimeout(() => {
                            window.location.href = '/protected'; // habilitaremos esto cuando modifiquemos las rutas de SESIONES
                        }, 1000);
                    }
                } else {
                    showMessage(data.error || 'Ocurrió un error', 'error');
                }
            } catch (error) {
                showMessage('Error de conexión con el servidor', 'error');
            } finally {
                submitBtn.disabled = false;
                submitBtn.style.opacity = '1';
            }
        });
    </script>
</body>

</html>